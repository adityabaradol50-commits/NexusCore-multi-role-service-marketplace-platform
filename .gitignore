# NexusCore Root .gitignore

# Python & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/

# Testing & Cache
.pytest_cache/
.coverage
htmlcov/

# Local databases (preserve local SQLite without committing to repo)
*.sqlite
*.sqlite3
*.db
nexuscore.db

# Environment variables & secrets (allow .env.example templates only)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Node.js & Next.js
node_modules/
.next/
out/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel
.vercel

# IDE & Operating System
.vscode/
.idea/
.DS_Store
Thumbs.db
*.pem
