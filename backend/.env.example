# NexusCore Backend Production Environment Configuration Template
# Copy this file to .env or configure these variables in Render Dashboard / cloud runner.
# DO NOT COMMIT REAL PRODUCTION SECRETS TO SOURCE CONTROL.

PROJECT_NAME=NexusCore Platform
ENVIRONMENT=production
DEBUG=false

# Managed PostgreSQL Database Connection String (Render / Supabase / AWS RDS)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
# Note: Render postgres:// or postgresql:// URLs are automatically normalized to use asyncpg.
DATABASE_URL=

# Cryptographic Token Signing Secret (generate with: openssl rand -hex 32)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed Frontend Origins (Comma-separated or JSON array)
# Example: https://nexuscore-frontend.vercel.app,http://localhost:3000
BACKEND_CORS_ORIGINS=

# Marketplace Fee Structure (Platform % commission, remainder goes to service provider)
PLATFORM_COMMISSION_PERCENTAGE=10.0

# Initial System Administrator Bootstrapping
# Set strong credentials for production initial setup.
FIRST_SUPERUSER_EMAIL=
FIRST_SUPERUSER_PASSWORD=

# Payment Provider Configuration (Options: "test", "stripe", "razorpay")
PAYMENT_PROVIDER=test
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Optional: Opt-in to seed demo marketplace catalog (Sungmo Heals, etc.) in production
# Default is false in production; set to true if deploying a live interactive demo.
SEED_DEMO_DATA=false
